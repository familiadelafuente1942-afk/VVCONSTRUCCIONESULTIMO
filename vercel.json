{
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/belfast/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://chatgpt.com"
        }
      ]
    }
  ],
  "functions": {
    "api/nexo2.js": {
      "maxDuration": 60
    },
    "api/edificio.js": {
      "maxDuration": 30
    },
    "api/auditoria.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/agenda-diaria",
      "schedule": "0 11 * * *"
    }
  ]
}