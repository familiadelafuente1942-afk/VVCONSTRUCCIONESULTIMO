{
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/belfast/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://chatgpt.com"
        }
      ]
    }
  ],
  "functions": {
    "api/nexo2.js": {
      "maxDuration": 60
    },
    "api/edificio.js": {
      "maxDuration": 30
    },
    "api/auditoria.js": {
      "maxDuration": 60
    },
    "api/claude.js": {
      "maxDuration": 60
    },
    "api/estudio-ig.js": {
      "maxDuration": 60
    },
    "api/mcp-asistente.js": {
      "maxDuration": 30
    },
    "api/mcp-nexo.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/agenda-diaria",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/nexo2?backup=1",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/mcp/nexo2/:k",
      "destination": "/api/mcp-nexo?k=:k"
    },
    {
      "source": "/mcp/asistente/:k",
      "destination": "/api/mcp-asistente?k=:k"
    },
    {
      "source": "/costos/:app/:k",
      "destination": "/api/auditoria?k=:k&costos=:app"
    },
    {
      "source": "/app/:app/:k",
      "destination": "/api/auditoria?k=:k&costos=:app"
    },
    {
      "source": "/obra/:app/:k",
      "destination": "/api/auditoria?k=:k&costos=:app"
    },
    {
      "source": "/ver/:app/:k",
      "destination": "/api/auditoria?k=:k&costos=:app"
    }
  ]
}