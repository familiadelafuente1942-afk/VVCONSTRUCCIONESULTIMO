{
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/nexo2.js": {
      "maxDuration": 60
    },
    "api/edificio.js": {
      "maxDuration": 30
    }
  }
}